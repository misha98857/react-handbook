{
  "name": "react-handbook",
  "version": "1.0.0",
  "author": "misha98857",
  "homepage": "https://github.com/misha98857/react-handbook",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=development",
    "build": "ng build --configuration=production",
    "sync": "ng build --configuration=production && npx ionic capacitor sync --configuration=production",
    "android-studio": "npx cap open android",
    "android:liveserver": "npx ionic cap run android -l --external",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint",
    "res": "capacitor-resources -p android",
    "content:install": "npm --prefix scripts/content install",
    "content:fetch": "npm --prefix scripts/content run fetch --",
    "content:build": "npm --prefix scripts/content run build --",
    "content:validate": "npm --prefix scripts/content run validate --",
    "playground:vendors": "node scripts/playground/download-vendors.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-browser-dynamic": "21.2.9",
    "@angular/router": "21.2.9",
    "@awesome-cordova-plugins/core": "^9.1.4",
    "@awesome-cordova-plugins/in-app-browser": "^9.1.4",
    "@awesome-cordova-plugins/splash-screen": "^9.1.4",
    "@awesome-cordova-plugins/status-bar": "^9.1.4",
    "@capacitor-community/firebase-analytics": "^8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@ionic/angular": "^8.8.4",
    "@ngrx/signals": "^21.1.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@types/lz-string": "^1.3.34",
    "@types/mark.js": "^8.11.12",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "core-js": "^3.49.0",
    "lz-string": "^1.5.0",
    "mark.js": "8.11.1",
    "prismjs": "^1.30.0",
    "rxjs": "^7.8.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@analogjs/vitest-angular": "^1.21.0",
    "@angular-eslint/builder": "^21.3.1",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/eslint-plugin-template": "^21.3.1",
    "@angular-eslint/schematics": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@angular/build": "^21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler": "21.2.9",
    "@angular/compiler-cli": "21.2.9",
    "@angular/language-service": "21.2.9",
    "@babel/compat-data": "^7.29.0",
